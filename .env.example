# Flowlog — environment variables (example)
# Copy this file to `.env` and replace every placeholder with real values.

# ------------------------------------------------------------------------------
# Application URLs
# ------------------------------------------------------------------------------
# Origin exposed to the browser (Next.js `NEXT_PUBLIC_*`).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Better Auth public base URL; use the same origin as the app in development.
BETTER_AUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database (Prisma → PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string only on the server. See https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ------------------------------------------------------------------------------
# Better Auth (session / cookie signing)
# ------------------------------------------------------------------------------
# Strong random secret, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET="your_better_auth_secret"

# ------------------------------------------------------------------------------
# Google OAuth (social sign-in)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ------------------------------------------------------------------------------
# Email — Resend (verification & password reset)
# ------------------------------------------------------------------------------
RESEND_API_KEY="your_resend_api_key"
# Optional. From address for transactional mail (see services/email.services.ts).
# RESEND_FROM="Flowlog <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# Storage — Cloudflare R2 (S3-compatible API, used for profile avatars)
# ------------------------------------------------------------------------------
AWS_REGION=auto
AWS_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
AWS_ACCESS_KEY_ID="your_r2_access_key_id"
AWS_SECRET_ACCESS_KEY="your_r2_secret_access_key"
AWS_S3_BUCKET_NAME="your_bucket_name"
